{
  "name": "bizflow-docs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "supabase:check": "node scripts/check-supabase-live.mjs",
    "supabase:check:rls": "node scripts/check-supabase-rls.mjs",
    "supabase:check:audit-chain": "node scripts/verify-audit-chain.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:duplication && pnpm check:deadcode && pnpm build && pnpm audit:dependencies",
    "check:e2e": "pnpm build && pnpm test:e2e",
    "test:e2e": "playwright test",
    "e2e:up": "corepack pnpm exec supabase start && docker compose -f docker-compose.e2e.yml up -d --wait && pnpm e2e:env",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down -v && corepack pnpm exec supabase stop",
    "e2e:env": "node scripts/write-e2e-env.mjs",
    "check:duplication": "jscpd src --format typescript,tsx --min-lines 5 --min-tokens 50 --mode strict --ignore '**/*.test.ts,**/*.test.tsx' --threshold 3 --reporters console --no-colors --no-tips",
    "check:deadcode": "knip --include files,dependencies,exports,unlisted,unresolved",
    "audit:dependencies": "corepack pnpm audit --prod --audit-level=moderate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@base-ui/react": "^1.7.0",
    "@google/genai": "2.17.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "inngest": "^4.18.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "npm:@cantoo/pdf-lib@^2.8.2",
    "posthog-js": "^1.417.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "jscpd": "5.0.15",
    "knip": "^6.32.2",
    "supabase": "2.114.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
