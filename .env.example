# BizFlow Docs environment template
# Copy this file to .env.local for local development.
# Keep real secrets out of this file and out of version control.

# -----------------------------------------------------------------------------
# App URLs and environment
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_NAME="BizFlow Docs"
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
PUBLIC_FORM_BASE_URL=http://localhost:3000/forms

# Server-only Vercel Cron bearer secret (minimum 16 random characters).
CRON_SECRET=

# -----------------------------------------------------------------------------
# Supabase server and admin configuration
# -----------------------------------------------------------------------------
# Server-side Supabase client values.
SUPABASE_URL=https://tmciougnqzbopuqyuacu.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=tmciougnqzbopuqyuacu
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.tmciougnqzbopuqyuacu.supabase.co:5432/postgres
SUPABASE_POOLER_URL=postgresql://postgres.tmciougnqzbopuqyuacu:YOUR_PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Admin-only values. Never expose these to browser clients.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://tmciougnqzbopuqyuacu.supabase.co/auth/v1/.well-known/jwks.json

# Optional, explicit two-tenant RLS verification fixtures.
# Use only isolated synthetic users and organizations; see `pnpm supabase:check:rls --help`.
BIZFLOW_RLS_TEST_CONFIRM=
BIZFLOW_RLS_OWNER_EMAIL=
BIZFLOW_RLS_OWNER_PASSWORD=
BIZFLOW_RLS_MANAGER_EMAIL=
BIZFLOW_RLS_MANAGER_PASSWORD=
BIZFLOW_RLS_ACTOR_A_EMAIL=
BIZFLOW_RLS_ACTOR_A_PASSWORD=
BIZFLOW_RLS_ACTOR_A_ORG_ID=
BIZFLOW_RLS_REVIEWER_EMAIL=
BIZFLOW_RLS_REVIEWER_PASSWORD=
BIZFLOW_RLS_ACTOR_B_EMAIL=
BIZFLOW_RLS_ACTOR_B_PASSWORD=
BIZFLOW_RLS_ACTOR_B_ORG_ID=
BIZFLOW_RLS_STAFF_SUBMISSION_ID=
BIZFLOW_RLS_STAFF_SUBMISSION_FILE_ID=
BIZFLOW_RLS_MANAGER_SUBMISSION_ID=
BIZFLOW_RLS_MANAGER_SUBMISSION_FILE_ID=

# -----------------------------------------------------------------------------
# Cloudflare R2 private storage
# -----------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=bizflow-docs-local
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_SIGNED_URL_TTL_SECONDS=900
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Inngest background jobs
# -----------------------------------------------------------------------------
INNGEST_APP_ID=bizflow-docs
INNGEST_SERVE_PATH=/api/inngest
# Set to 1 for local development against `npx inngest-cli@latest dev`.
# The SDK does NOT infer dev mode from NODE_ENV: without this it assumes cloud
# mode, finds no signing key, and the serve route returns 500. Leave it unset in
# every deployed environment.
INNGEST_DEV=1
# Both keys stay empty locally — the Dev Server needs no credentials. In
# production the Inngest Vercel integration sets them automatically.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Resend transactional email
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
RESEND_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# AI document-template assistant
# -----------------------------------------------------------------------------
# Server-only. Flow returns validated edits for the current unsaved draft.
# Gemini is the currently registered adapter. The core accepts additional
# adapters without changing Flow, and never silently switches provider/model.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
AI_TIMEOUT_MS=30000
GEMINI_API_KEY=

# Deprecated one-release compatibility aliases. Leave unset after migrating.
# They are read only when the matching AI-prefixed value is absent.
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=

# -----------------------------------------------------------------------------
# SMS provider selection and provider credentials
# -----------------------------------------------------------------------------
# Supported values: termii, africas_talking, disabled
SMS_PROVIDER=termii
SMS_DEFAULT_COUNTRY_CODE=NG
SMS_FROM=BizFlow
SMS_WEBHOOK_SECRET=

# Termii placeholders.
TERMII_API_KEY=
TERMII_SENDER_ID=BizFlow
TERMII_CHANNEL=generic
TERMII_BASE_URL=https://api.ng.termii.com/api

# Africa's Talking placeholders for later provider switching.
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=BizFlow
AFRICAS_TALKING_ENVIRONMENT=sandbox

# -----------------------------------------------------------------------------
# Upstash Redis (distributed rate limiting; unset = limits disabled)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Sentry monitoring
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# -----------------------------------------------------------------------------
# PostHog or internal analytics
# -----------------------------------------------------------------------------
# Supported values: internal, posthog, disabled
ANALYTICS_PROVIDER=internal
NEXT_PUBLIC_ANALYTICS_PROVIDER=internal
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PERSONAL_API_KEY=
INTERNAL_ANALYTICS_TABLE=analytics_events

# -----------------------------------------------------------------------------
# File upload limits and allowed MIME types
# -----------------------------------------------------------------------------
FILE_UPLOAD_MAX_BYTES=20971520
NEXT_PUBLIC_FILE_UPLOAD_MAX_BYTES=20971520
FILE_UPLOAD_MAX_FILES_PER_SUBMISSION=10
FILE_UPLOAD_SIGNED_URL_TTL_SECONDS=900
FILE_UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv
NEXT_PUBLIC_FILE_UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv

# -----------------------------------------------------------------------------
# Optional feature flags
# -----------------------------------------------------------------------------
FEATURE_SMS_NOTIFICATIONS=false
FEATURE_PUBLIC_FORMS=true
# Deferred for the cloud-first MVP. Keep both flags false until offline work is explicitly reactivated.
FEATURE_OFFLINE_DRAFTS=false
FEATURE_ANALYTICS=false
NEXT_PUBLIC_FEATURE_SMS_NOTIFICATIONS=false
NEXT_PUBLIC_FEATURE_PUBLIC_FORMS=true
NEXT_PUBLIC_FEATURE_OFFLINE_DRAFTS=false
NEXT_PUBLIC_FEATURE_ANALYTICS=false
