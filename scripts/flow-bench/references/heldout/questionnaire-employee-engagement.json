{
  "request": "anonymous staff engagement survey for our 40-person manufacturing company",
  "title": "Staff engagement survey",
  "description": "Send to every employee once a year, anonymously, to measure how engaged they feel and how they see their work, their manager, their team, their development, fair treatment, workload, pay and leadership.",
  "maxPages": 4,
  "content": {
    "schemaVersion": 3,
    "branding": {
      "organizationName": "",
      "logoAsset": null,
      "logoDataUrl": null,
      "logoAlignment": "left",
      "logoWidthPercent": 24,
      "primaryColor": "#252329",
      "accentColor": "#635273"
    },
    "blocks": [
      {
        "id": "d5060000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Staff engagement survey",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "d5060000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "This survey asks how you feel about working here. It is anonymous: please do not write your name anywhere on it. We only ever report results for groups of at least five people, so no one's answers can be picked out, and the questions about you at the end are optional.",
        "alignment": "left"
      },
      {
        "id": "d5060000-0000-4000-8000-000000000003",
        "type": "paragraph",
        "text": "For each statement, choose the answer closest to how you feel. There are no right or wrong answers, and honest answers help us most. We will share the overall results with everyone and tell you what we plan to do about them.",
        "alignment": "left"
      },
      {
        "id": "d5060000-0000-4000-8000-000000000049",
        "type": "choice_grid_field",
        "fieldKey": "your_work",
        "label": "How far do you agree with each statement?",
        "required": true,
        "helpText": null,
        "rows": [
          "I find my work interesting.",
          "I have a clear idea of what is expected of me.",
          "I have enough say in how I do my work."
        ],
        "options": [
          "Strongly agree",
          "Agree",
          "Neutral",
          "Disagree",
          "Strongly disagree"
        ]
      },
      {
        "id": "d5060000-0000-4000-8000-000000000050",
        "type": "choice_grid_field",
        "fieldKey": "our_purpose",
        "label": "How far do you agree with each statement?",
        "required": true,
        "helpText": null,
        "rows": [
          "I understand how my work helps the company meet its goals.",
          "I know what the company is trying to achieve over the next year."
        ],
        "options": [
          "Strongly agree",
          "Agree",
          "Neutral",
          "Disagree",
          "Strongly disagree"
        ]
      },
      {
        "id": "d5060000-0000-4000-8000-000000000051",
        "type": "choice_grid_field",
        "fieldKey": "your_manager",
        "label": "How far do you agree with each statement?",
        "required": true,
        "helpText": null,
        "rows": [
          "My manager gives me useful feedback on my work.",
          "My manager recognises it when I do my job well.",
          "I can talk to my manager about anything that worries me."
