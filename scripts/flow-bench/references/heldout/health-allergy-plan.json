    "blocks": [
      {
        "id": "0b140000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Allergy and anaphylaxis care plan",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "0b140000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "This plan tells staff how to keep your child safe at school and what to do if they have an allergic reaction. Please answer every question, read what staff will do, and attach the allergy action plan signed by your child's doctor or nurse. We will review the plan with you each year, or sooner if anything changes.",
        "alignment": "left"
      },
      {
        "id": "0b140000-0000-4000-8000-000000000003",
        "type": "paragraph",
        "text": "How we use your information: we use this plan to care for your child and to act quickly in an emergency. With your agreement we display a copy, with your child's photo, where staff who look after your child can see it. We share it with emergency services if your child needs urgent help, and keep it on your child's school record.",
        "runs": [
          {
            "text": "How we use your information:",
            "bold": true
          },
          {
            "text": " we use this plan to care for your child and to act quickly in an emergency. With your agreement we display a copy, with your child's photo, where staff who look after your child can see it. We share it with emergency services if your child needs urgent help, and keep it on your child's school record."
          }
        ],
        "alignment": "left"
      },
