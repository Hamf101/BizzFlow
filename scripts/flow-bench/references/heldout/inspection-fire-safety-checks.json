    },
    "blocks": [
      {
        "id": "d4060000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Monthly fire safety checks",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "d4060000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Walk the whole office and answer each question. Any No needs action: describe it under Problems found so it can be put right.",
        "alignment": "left"
      },
      {
        "id": "d4060000-0000-4000-8000-000000000003",
        "type": "text_field",
        "fieldKey": "premises",
        "label": "Premises",
        "required": true,
        "helpText": "The office name or address.",
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d4060000-0000-4000-8000-000000000005",
        "type": "date_field",
        "fieldKey": "date_of_check",
        "label": "Date of check",
        "required": true,
        "helpText": null,
        "dateFormat": {
          "order": "ymd",
          "separator": "-",
          "month": "number"
        }
      },
      {
        "id": "d4060000-0000-4000-8000-000000000007",
        "type": "text_field",
        "fieldKey": "checked_by",
        "label": "Checked by",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d4060000-0000-4000-8000-000000000008",
        "type": "text_field",
        "fieldKey": "position",
        "label": "Position",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d4060000-0000-4000-8000-000000000043",
        "type": "choice_grid_field",
        "fieldKey": "escape_route_checks",
        "label": "Routes, exits, signs and doors",
        "required": true,
        "helpText": null,
        "rows": [
          "Are all escape routes, corridors and stairs clear of anything that could block them or catch fire?",
          "Do all fire exits open easily from the inside, without a key?",
          "Are fire exit signs in place and easy to see?",
          "Do fire doors close fully on their own, with none wedged open?"
        ],
        "options": [
          "Yes",
          "No"
        ]
      },
      {
        "id": "d4060000-0000-4000-8000-000000000044",
        "type": "choice_grid_field",
        "fieldKey": "alarm_and_lighting_checks",
        "label": "Alarm tests, panel and lights",
        "required": true,
        "helpText": null,
        "rows": [
          "Was the fire alarm tested each week this month, with each test written in the fire log book?",
          "Could the alarm be heard clearly in every part of the office?",
          "Is the alarm panel free of fault warnings?",
          "Did every emergency light come on in this month's short test?"
        ],
        "options": [
          "Yes",
          "No"
        ]
      },
      {
        "id": "d4060000-0000-4000-8000-000000000045",
        "type": "choice_grid_field",
        "fieldKey": "extinguisher_checks",
        "label": "Position, seals, gauges and labels",
        "required": true,
        "helpText": null,
        "rows": [
          "Is each extinguisher in its place, mounted or on its stand, with nothing in front of it?",
          "Is each safety pin and tamper seal in place?",
          "Does each pressure gauge read in the green?",
          "Is each extinguisher free of damage, with its instructions readable?",
          "Is each extinguisher's service label within date?"
        ],
        "options": [
          "Yes",
          "No"
        ]
      },
      {
        "id": "d4060000-0000-4000-8000-000000000046",
        "type": "choice_grid_field",
        "fieldKey": "housekeeping_checks",
        "label": "Waste, heaters, sockets, notices and new starters",
        "required": true,
        "helpText": null,
        "rows": [
          "Is waste paper and packaging cleared away rather than left to build up?",
          "Are heaters kept well away from paper, furniture and curtains?",
          "Are sockets free of overloaded adaptors and extension leads plugged into each other?",
          "Are fire action notices on display beside the call points and exits?",
          "Has everyone who started this month been shown the escape routes and assembly point?"
        ],
        "options": [
          "Yes",
          "No"
        ]
      },
      {
        "id": "d4060000-0000-4000-8000-000000000032",
        "type": "date_field",
        "fieldKey": "date_of_the_last_fire_drill",
        "label": "Date of the last fire drill",
        "required": true,
        "helpText": null,
        "dateFormat": {
          "order": "ymd",
          "separator": "-",
          "month": "number"
        }
      },
      {
        "id": "d4060000-0000-4000-8000-000000000033",
        "type": "dropdown_field",
        "fieldKey": "did_you_find_any_problem",
        "label": "Did you find any problem?",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "options": [
          "Yes",
          "No"
        ],
        "display": "radios",
        "across": true
      },
      {
        "id": "d4060000-0000-4000-8000-000000000035",
        "type": "text_field",
        "fieldKey": "what_did_you_find_and_where",
