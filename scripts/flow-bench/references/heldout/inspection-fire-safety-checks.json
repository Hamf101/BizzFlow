{
  "request": "monthly fire safety checklist for a small office",
  "title": "Monthly fire safety checks",
  "description": "Use once a month to check an office's escape routes, fire alarm, emergency lighting, extinguishers and housekeeping, and to record any problem and what is being done about it.",
  "maxPages": 2,
  "content": {
    "schemaVersion": 3,
    "branding": {
      "organizationName": "",
      "logoAsset": null,
      "logoDataUrl": null,
      "logoAlignment": "left",
