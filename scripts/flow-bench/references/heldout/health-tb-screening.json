{
  "request": "TB screening form for new hires at our dialysis clinics in Texas, following the CDC's baseline screening for health care personnel: risk assessment, symptom check, TB history, the test result and clearance by employee health.",
  "title": "Baseline tuberculosis screening",
  "description": "Use when a new member of staff joins, before they start work with patients: their TB risk, any signs of TB disease, their TB history, the baseline test result and clearance by employee health.",
  "maxPages": 3,
  "content": {
    "schemaVersion": 3,
    "branding": {
      "organizationName": "",
      "logoAsset": null,
