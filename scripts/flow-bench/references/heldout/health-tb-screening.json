      {
        "id": "0b150000-0000-4000-8000-000000000069",
        "type": "choice_grid_field",
        "fieldKey": "signs_of_tb_disease",
        "label": "Do you have any of the following now, or have you had them in the last three weeks?",
        "required": true,
        "helpText": null,
        "rows": [
          "A cough that has lasted three weeks or longer",
          "Coughing up blood",
          "Fever or chills without another explanation",
          "Drenching sweats at night",
          "Weight loss you cannot explain",
          "Tiredness that is not usual for you"
        ],
        "options": [
          "Yes",
          "No"
        ]
      },
      {
        "id": "0b150000-0000-4000-8000-000000000030",
        "type": "paragraph",
        "text": "If you answered yes to any of these, tell employee health before your start date. You will be checked for TB disease, usually with a chest X-ray, before you work with patients.",
        "runs": [
          {
            "text": "If you answered yes to any of these,",
            "bold": true
          },
          {
            "text": " tell employee health before your start date. You will be checked for TB disease, usually with a chest X-ray, before you work with patients."
