      },
      {
        "id": "0b150000-0000-4000-8000-000000000019",
        "type": "dropdown_field",
        "fieldKey": "have_you_ever_lived_for_one_month_or_more_in_a_country_with",
        "label": "Have you ever lived for one month or more in a country with a high rate of TB?",
        "required": true,
        "helpText": "Answer yes for any country other than the United States, Canada, Australia, New Zealand, or a country in western or northern Europe.",
        "placeholder": null,
        "options": [
          "Yes",
          "No"
        ],
        "display": "radios",
        "across": true
      },
      {
        "id": "0b150000-0000-4000-8000-000000000020",
        "type": "dropdown_field",
        "fieldKey": "do_you_have_or_expect_to_have_a_weakened_immune_system",
        "label": "Do you have, or expect to have, a weakened immune system?",
        "required": true,
        "helpText": "For example, from HIV, an organ transplant, or high-dose steroids or other drugs that suppress the immune system.",
        "placeholder": null,
        "options": [
          "Yes",
          "No"
