    "blocks": [
      {
        "id": "0b150000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Baseline tuberculosis screening",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "0b150000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Everyone who joins us to work in our clinics is screened for tuberculosis (TB) before they start. Screening has four parts: a TB risk assessment, a check for signs of TB disease, a TB blood or skin test, and further checks if any of these suggest them. The employee completes sections A to D and signs section G; employee health completes sections E and F.",
        "alignment": "left"
      },
      {
        "id": "0b150000-0000-4000-8000-000000000003",
        "type": "paragraph",
        "text": "How we use your information: employee health uses this form to decide whether you can start work safely and to offer you follow-up care. It is kept in a confidential employee health file, separate from your personnel file, and seen only by employee health staff. We share it with the health department only when the law requires us to report TB.",
        "runs": [
          {
            "text": "How we use your information:",
            "bold": true
          },
          {
            "text": " employee health uses this form to decide whether you can start work safely and to offer you follow-up care. It is kept in a confidential employee health file, separate from your personnel file, and seen only by employee health staff. We share it with the health department only when the law requires us to report TB."
          }
        ],
        "alignment": "left"
      },
