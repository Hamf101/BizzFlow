{
  "request": "New starter form for payroll and HR. Personal details, bank details for wages, the tax information HMRC's starter checklist asks for, student loans, emergency contact, and the job details we fill in. It's confidential.",
  "title": "New starter details",
  "description": "Use when someone joins the payroll: their personal details, bank account for wages, the starter tax statement and student loans, an emergency contact, and the job details HR fills in.",
  "maxPages": 3,
  "content": {
    "schemaVersion": 3,
    "branding": {
      "organizationName": "",
      "logoAsset": null,
      "logoDataUrl": null,
      "logoAlignment": "left",
      "logoWidthPercent": 24,
      "primaryColor": "#3c3c3c",
      "accentColor": "#6b7280"
    },
    "blocks": [
      {
        "id": "0c120000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "New starter details",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "0c120000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Welcome. Please fill in sections A to E before your first day, so that we can pay you correctly and on time. HR fills in section F.",
        "alignment": "left"
      },
      {
        "id": "0c120000-0000-4000-8000-000000000003",
        "type": "paragraph",
        "text": "How we use your information: payroll uses these details to pay you, to work out your tax and student loan deductions and to report your pay to HM Revenue and Customs. HR uses them to keep your employment record and to contact someone in an emergency. They are kept in your confidential personnel file while you work here and for as long afterwards as tax and employment law require.",
        "runs": [
          {
            "text": "How we use your information:",
            "bold": true
          },
          {
            "text": " payroll uses these details to pay you, to work out your tax and student loan deductions and to report your pay to HM Revenue and Customs. HR uses them to keep your employment record and to contact someone in an emergency. They are kept in your confidential personnel file while you work here and for as long afterwards as tax and employment law require."
          }
        ],
        "alignment": "left"
      },
      {
