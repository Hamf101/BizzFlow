      {
        "id": "0c120000-0000-4000-8000-000000000027",
        "type": "dropdown_field",
        "fieldKey": "which_statement_is_true_for_you",
        "label": "Which statement is true for you?",
        "required": false,
        "helpText": "Only if you do not have a P45. Choose the first statement that is true for you.",
        "placeholder": null,
        "options": [
          "A: This is my first job since 6 April. I have not received Jobseeker's Allowance, Employment and Support Allowance or Incapacity Benefit, or a state or work pension.",
          "B: This is now my only job, but since 6 April I have had another job or received one of those benefits. I do not receive a state or work pension.",
          "C: As well as this job, I have another job, or I receive a state or work pension."
