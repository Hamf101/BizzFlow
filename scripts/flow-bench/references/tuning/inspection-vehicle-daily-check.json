{
  "request": "daily vehicle check sheet for our van drivers",
  "title": "Daily vehicle check",
  "description": "Use at the start of each shift, for a van driver to check the vehicle before driving it, record any defect and hand it on for repair.",
  "maxPages": 2,
  "content": {
    "schemaVersion": 3,
    "branding": {
      "organizationName": "",
      "logoAsset": null,
      "logoDataUrl": null,
      "logoAlignment": "left",
      "logoWidthPercent": 24,
      "primaryColor": "#252329",
      "accentColor": "#635273"
    },
    "blocks": [
      {
        "id": "d4010000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Daily vehicle check",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "d4010000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Walk round the vehicle and check each item before you drive it. Fill this sheet in every day, even when you find nothing wrong: a check with no defects is still a record that the check was done.",
        "alignment": "left"
      },
      {
        "id": "d4010000-0000-4000-8000-000000000003",
        "type": "text_field",
        "fieldKey": "registration_number",
        "label": "Registration number",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d4010000-0000-4000-8000-000000000005",
        "type": "text_field",
        "fieldKey": "mileage_at_start_of_shift",
        "label": "Mileage at start of shift",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "multiline": false,
        "format": "number",
        "suffix": "miles"
      },
      {
        "id": "d4010000-0000-4000-8000-000000000007",
        "type": "text_field",
        "fieldKey": "driver_name",
        "label": "Driver name",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d4010000-0000-4000-8000-000000000008",
        "type": "date_field",
        "fieldKey": "date_of_check",
        "label": "Date of check",
        "required": true,
        "helpText": null,
        "dateFormat": {
          "order": "dmy",
          "separator": "/",
          "month": "number"
        }
      },
      {
        "id": "d4010000-0000-4000-8000-000000000009",
        "type": "text_field",
        "fieldKey": "time_of_check",
        "label": "Time of check",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "multiline": false,
        "format": "time"
      },
      {
        "id": "d4010000-0000-4000-8000-000000000047",
        "type": "choice_grid_field",
        "fieldKey": "outside_checks",
        "label": "Walk-round checks",
        "required": true,
        "helpText": "Ask someone to help you check the brake lights.",
        "rows": [
          "Tyres and wheels: tread, cuts and bulges, pressure, and wheel nuts in place",
          "Lights, indicators and reflectors: all working, clean and not cracked",
          "Mirrors and glass: mirrors secure and adjusted; windscreen free of cracks in your line of sight",
          "Wipers and washers",
          "Bodywork and doors: no sharp edges or loose panels; every door shuts and locks",
          "Load and load restraints: the load is secure, evenly spread and within the vehicle's limits",
          "Number plates: clean, readable and secure",
          "Leaks under the vehicle: fuel, oil, coolant or other fluid on the ground"
        ],
        "options": [
          "OK",
          "Defect"
        ]
      },
      {
        "id": "d4010000-0000-4000-8000-000000000048",
        "type": "choice_grid_field",
        "fieldKey": "cab_checks",
        "label": "Brakes, controls and equipment",
        "required": true,
        "helpText": null,
        "rows": [
          "Brakes, including the parking brake",
          "Steering: no excessive play or stiffness",
          "Horn",
          "Dashboard warning lights: none stay lit once the engine is running",
          "Seat belts: each belt fastens, releases and retracts",
          "Fuel, oil and fluid levels",
          "Safety equipment on board: for example the fire extinguisher, first aid kit, warning triangle and high-visibility vest"
        ],
        "options": [
          "OK",
          "Defect"
        ]
      },
      {
        "id": "d4010000-0000-4000-8000-000000000028",
        "type": "dropdown_field",
        "fieldKey": "did_you_find_any_defect",
        "label": "Did you find any defect?",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "options": [
          "Yes",
          "No"
        ],
        "display": "radios",
        "across": true
      },
      {
        "id": "d4010000-0000-4000-8000-000000000030",
        "type": "text_field",
        "fieldKey": "describe_each_defect_and_where_it_is",
        "label": "Describe each defect and where it is",
        "required": true,
        "helpText": "Say what is wrong and which part of the vehicle it is on.",
        "visibleWhen": {
          "sourceBlockId": "d4010000-0000-4000-8000-000000000028",
          "operator": "equals",
          "value": "Yes"
        },
        "placeholder": null,
        "multiline": true
      },
      {
        "id": "d4010000-0000-4000-8000-000000000031",
        "type": "dropdown_field",
        "fieldKey": "is_the_vehicle_safe_to_drive",
        "label": "Is the vehicle safe to drive?",
        "required": true,
        "helpText": "If you are not sure, answer No and do not drive it until it has been checked.",
        "visibleWhen": {
          "sourceBlockId": "d4010000-0000-4000-8000-000000000028",
          "operator": "equals",
          "value": "Yes"
        },
        "placeholder": null,
        "options": [
          "Yes",
          "No"
        ],
        "display": "radios",
        "across": true
      },
      {
        "id": "d4010000-0000-4000-8000-000000000032",
        "type": "text_field",
        "fieldKey": "who_did_you_report_the_defect_to",
        "label": "Who did you report the defect to?",
        "required": true,
        "helpText": null,
        "visibleWhen": {
          "sourceBlockId": "d4010000-0000-4000-8000-000000000028",
          "operator": "equals",
          "value": "Yes"
        },
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d4010000-0000-4000-8000-000000000033",
        "type": "paragraph",
        "text": "I have checked this vehicle and recorded every defect I found.",
        "alignment": "left"
      },
      {
        "id": "d4010000-0000-4000-8000-000000000035",
        "type": "signature_field",
        "fieldKey": "driver_signature",
        "label": "Driver signature",
        "required": true,
        "helpText": null
      },
      {
        "id": "d4010000-0000-4000-8000-000000000036",
        "type": "date_field",
        "fieldKey": "date_signed_by_driver",
        "label": "Date signed by driver",
        "required": true,
        "helpText": null,
        "dateFormat": {
          "order": "dmy",
          "separator": "/",
          "month": "number"
        }
      },
      {
        "id": "d4010000-0000-4000-8000-000000000038",
        "type": "paragraph",
        "text": "For the person responsible for the vehicles, when a defect has been reported.",
        "alignment": "left"
      },
      {
        "id": "d4010000-0000-4000-8000-000000000040",
        "type": "text_field",
        "fieldKey": "what_was_done_to_put_the_defect_right",
        "label": "What was done to put the defect right?",
        "required": false,
        "helpText": null,
        "placeholder": null,
        "multiline": true
      },
      {
        "id": "d4010000-0000-4000-8000-000000000041",
        "type": "text_field",
        "fieldKey": "repaired_by",
        "label": "Repaired by",
        "required": false,
        "helpText": null,
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d4010000-0000-4000-8000-000000000042",
        "type": "date_field",
        "fieldKey": "date_repaired",
        "label": "Date repaired",
        "required": false,
        "helpText": null,
        "dateFormat": {
          "order": "dmy",
          "separator": "/",
          "month": "number"
        }
      },
      {
        "id": "d4010000-0000-4000-8000-000000000044",
        "type": "signature_field",
        "fieldKey": "signature_of_person_signing_off_the_repair",
        "label": "Signature of person signing off the repair",
        "required": false,
        "helpText": null
      },
      {
        "id": "d4010000-0000-4000-8000-000000000045",
        "type": "date_field",
        "fieldKey": "date_signed_off",
        "label": "Date signed off",
        "required": false,
        "helpText": null,
        "dateFormat": {
          "order": "dmy",
          "separator": "/",
          "month": "number"
        }
      }
