{
  "request": "Job application form for a housing association. Include guidance notes for applicants, personal details, right to work, current job, employment history with gaps explained, education and qualifications, a supporting statement against the person specification, two references, criminal convictions, adjustments for interview and a declaration. Equal opportunities monitoring is on a separate sheet so leave it out.",
  "title": "Job application form",
  "description": "Use when someone applies for a job: guidance for applicants, then the job, their details, right to work, current job, employment history, qualifications, supporting statement, references, convictions, interview adjustments and a declaration.",
  "maxPages": 7,
  "content": {
    "schemaVersion": 3,
    "branding": {
      "organizationName": "",
      "logoAsset": null,
      "logoDataUrl": null,
      "logoAlignment": "left",
