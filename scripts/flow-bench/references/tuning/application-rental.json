      {
        "id": "0a110000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Rental application",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "0a110000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Please complete one form for each adult who will be named on the tenancy. We use your answers to decide whether to offer you the tenancy and to set it up.",
        "alignment": "left"
      },
      {
        "id": "0a110000-0000-4000-8000-000000000003",
        "type": "paragraph",
        "text": "How we use your information: we use your details to assess this application, to check your right to rent and, with your agreement, to contact your referees and employer. If you become our tenant we keep them for as long as the tenancy lasts and for as long afterwards as the law requires; if not, we delete them once the property is let. We share them only with referencing agencies working for us, and with others when the law requires it.",
        "runs": [
          {
            "text": "How we use your information:",
            "bold": true
          },
          {
            "text": " we use your details to assess this application, to check your right to rent and, with your agreement, to contact your referees and employer. If you become our tenant we keep them for as long as the tenancy lasts and for as long afterwards as the law requires; if not, we delete them once the property is let. We share them only with referencing agencies working for us, and with others when the law requires it."
          }
        ],
        "alignment": "left"
      },
