      "accentColor": "#635273"
    },
    "blocks": [
      {
        "id": "d4020000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Weekly site safety inspection",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "d4020000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Walk the whole site and answer every question. Mark anything that needs putting right as Action needed and add it to the actions in section G. Finish the report before the end of the working day and give a copy to the site manager.",
        "alignment": "left"
      },
      {
        "id": "d4020000-0000-4000-8000-000000000003",
        "type": "text_field",
        "fieldKey": "site_name",
        "label": "Site name",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "multiline": false
      },
      {
