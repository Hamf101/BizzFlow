        "required": true,
        "helpText": null,
        "visibleWhen": {
          "sourceBlockId": "d4020000-0000-4000-8000-000000000047",
          "operator": "equals",
          "value": "No"
        },
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d4020000-0000-4000-8000-000000000049",
        "type": "text_field",
        "fieldKey": "their_position",
        "label": "Their position",
        "required": true,
        "helpText": null,
        "visibleWhen": {
          "sourceBlockId": "d4020000-0000-4000-8000-000000000047",
          "operator": "equals",
          "value": "No"
        },
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d4020000-0000-4000-8000-000000000050",
        "type": "paragraph",
        "text": "List each action needed, who will take it and by when, and tick it off when it is done.",
        "alignment": "left"
      },
      {
        "id": "d4020000-0000-4000-8000-000000000068",
        "type": "table_field",
        "fieldKey": "actions_needed",
        "label": "Action plan",
