      },
      {
        "id": "d4020000-0000-4000-8000-000000000015",
        "type": "dropdown_field",
        "fieldKey": "why_is_this_inspection_being_done",
        "label": "Why is this inspection being done?",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "options": [
          "Routine weekly inspection",
          "Before first use",
          "After bad weather",
          "After alteration or damage",
          "Other"
        ],
        "display": "radios"
      },
      {
        "id": "d4020000-0000-4000-8000-000000000016",
        "type": "text_field",
        "fieldKey": "what_other_reason_is_there_for_this_inspection",
        "label": "What other reason is there for this inspection?",
        "required": true,
        "helpText": null,
        "visibleWhen": {
          "sourceBlockId": "d4020000-0000-4000-8000-000000000015",
          "operator": "equals",
          "value": "Other"
        },
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d4020000-0000-4000-8000-000000000063",
        "type": "choice_grid_field",
        "fieldKey": "site_set_up_checks",
        "label": "Security, signs, welfare and lighting",
        "required": true,
        "helpText": null,
        "rows": [
          "Is the site boundary secure, with the public kept out of the work area?",
          "Are site rules, emergency contacts and required signs on display?",
          "Are toilets, washing facilities and a rest area provided and clean?",
          "Is there a stocked first aid kit, and does everyone know who the first aider is?",
          "Are pedestrian routes kept apart from vehicles and plant?",
          "Is lighting adequate in work areas and on access routes?"
        ],
        "options": [
          "Satisfactory",
          "Action needed",
          "Not applicable"
        ]
      },
      {
        "id": "d4020000-0000-4000-8000-000000000064",
        "type": "choice_grid_field",
        "fieldKey": "work_at_height_checks",
        "label": "Scaffolds, ladders, openings and towers",
        "required": true,
        "helpText": null,
        "rows": [
          "Has each scaffold been inspected in the last seven days, with its tag or record up to date?",
          "Are guard rails, mid rails and toe boards in place on every working platform?",
          "Are ladders in good condition, secured, and used only for short, light work?",
          "Are openings and fragile surfaces covered or protected, and marked?",
          "Are mobile towers and access platforms set up as their instructions require?"
        ],
        "options": [
          "Satisfactory",
          "Action needed",
          "Not applicable"
        ]
      },
      {
        "id": "d4020000-0000-4000-8000-000000000065",
        "type": "choice_grid_field",
        "fieldKey": "excavation_checks",
        "label": "Sides, edges, access and services",
        "required": true,
        "helpText": null,
        "rows": [
          "Are excavation sides supported, stepped or battered back?",
          "Are edges protected, so no one and nothing can fall in?",
          "Is there a safe way in and out of each excavation?",
          "Are spoil, materials and plant kept back from the edges?",
          "Were underground services located and marked before digging?"
        ],
        "options": [
          "Satisfactory",
          "Action needed",
          "Not applicable"
        ]
      },
      {
        "id": "d4020000-0000-4000-8000-000000000066",
        "type": "choice_grid_field",
        "fieldKey": "housekeeping_fire_and_electrics_checks",
        "label": "Routes, storage, fire points and electrics",
        "required": true,
        "helpText": null,
        "rows": [
          "Are walkways, stairs and access routes clear of materials and waste?",
          "Are materials stored safely and waste removed regularly?",
          "Are fire points equipped, escape routes clear, and flammable materials stored safely?",
          "Are temporary electrics, leads and tools in good condition and protected from damage?"
        ],
        "options": [
          "Satisfactory",
          "Action needed",
          "Not applicable"
        ]
      },
      {
        "id": "d4020000-0000-4000-8000-000000000067",
        "type": "choice_grid_field",
        "fieldKey": "plant_and_protective_equipment_checks",
        "label": "Operators, lifting and protective equipment",
        "required": true,
        "helpText": null,
        "rows": [
          "Is plant operated only by trained people, with daily checks recorded?",
          "Are lifting operations planned, with lifting equipment inspected and in date?",
          "Is everyone wearing the protective equipment the work needs, such as hard hats, high-visibility clothing, safety boots, gloves, and eye and hearing protection?"
        ],
        "options": [
          "Satisfactory",
          "Action needed",
          "Not applicable"
        ]
      },
      {
        "id": "d4020000-0000-4000-8000-000000000045",
        "type": "text_field",
        "fieldKey": "what_did_you_find_that_could_put_anyone_s_health_or_safety",
        "label": "What did you find that could put anyone's health or safety at risk?",
        "required": true,
        "helpText": "Describe each matter and where on site it is. Write None if you found nothing.",
        "placeholder": null,
        "multiline": true,
        "boxHeight": 75
      },
      {
        "id": "d4020000-0000-4000-8000-000000000047",
        "type": "dropdown_field",
        "fieldKey": "can_work_carry_on_safely",
        "label": "Can work carry on safely?",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "options": [
          "Yes",
          "No"
        ],
        "display": "radios",
        "across": true
      },
      {
        "id": "d4020000-0000-4000-8000-000000000048",
        "type": "text_field",
        "fieldKey": "who_was_told_to_stop_work",
