      {
        "id": "d6010000-0000-4000-8000-000000000045",
        "type": "date_field",
        "fieldKey": "date_signed_by_parent_or_guardian",
        "label": "Date signed by parent or guardian",
        "required": true,
        "helpText": null,
        "visibleWhen": {
          "sourceBlockId": "d6010000-0000-4000-8000-000000000038",
          "operator": "equals",
          "value": "Yes"
        },
        "dateFormat": {
          "order": "dmy",
          "separator": " ",
          "month": "long"
        }
      },
      {
        "id": "d6010000-0000-4000-8000-000000000047",
        "type": "paragraph",
        "text": "We use the details on this form to run the activity safely, to contact you or your emergency contact if we need to, and to keep a record of your agreement in case of an accident or claim. Your guide sees what you tell us about your fitness, and we share it with emergency services only if you need help. We keep this form for as long as we may need it in case of a claim, and then destroy it securely. You can ask to see the information we hold about you, and ask us to correct it.",
        "alignment": "left"
      },
      {
        "id": "d6010000-0000-4000-8000-000000000049",
        "type": "checkbox_field",
        "fieldKey": "i_have_read_and_understood_this_document_and_i_have_had_the",
        "label": "I have read and understood this document, and I have had the chance to ask questions about it.",
        "required": true,
        "helpText": null,
        "checkedByDefault": false
      },
