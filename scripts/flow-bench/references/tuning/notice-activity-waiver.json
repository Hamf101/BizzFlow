      {
        "id": "d6010000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Participation agreement and release",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "d6010000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Please read this whole document before you sign it. It explains the risks of paddling, what we do to keep you safe, what we ask of you, and the rights you give up by signing. If anything is unclear, ask a member of our team before you go on the water.",
        "alignment": "left"
      },
      {
        "id": "d6010000-0000-4000-8000-000000000003",
        "type": "text_field",
        "fieldKey": "full_name",
        "label": "Full name",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "multiline": false
      },
