      {
        "id": "d6010000-0000-4000-8000-000000000015",
        "type": "paragraph",
        "text": "In this document:",
        "alignment": "left"
      },
      {
        "id": "d6010000-0000-4000-8000-000000000017",
        "type": "bullet_list",
        "items": [
          "we, us and our mean the business named on your booking, and its guides, instructors and staff;",
          "you means the person named above who is taking part, and participant means anyone taking part;",
          "the activity means the kayak hire, guided paddle, lesson or other activity you are booked on, including getting on and off the water, carrying boats and any time spent on the bank or shore during it; and",
          "equipment means the kayaks, paddles, buoyancy aids, helmets, spray decks and any other kit we lend you."
        ],
        "itemRuns": [
