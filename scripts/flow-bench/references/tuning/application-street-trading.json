      "primaryColor": "#1f3a5f",
      "accentColor": "#2f6690"
    },
    "blocks": [
      {
        "id": "0a120000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Application for street trading consent",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "0a120000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Use this form to apply for consent to trade in a street the council has designated as a consent street. Please answer every question that applies to you. We may refuse an application, or give consent for fewer days, times or places than you asked for.",
        "alignment": "left"
      },
      {
        "id": "0a120000-0000-4000-8000-000000000003",
        "type": "heading",
        "text": "Before you start",
        "level": 2,
        "alignment": "left"
      },
      {
        "id": "0a120000-0000-4000-8000-000000000004",
        "type": "bullet_list",
        "items": [
          "Read the list of consent streets and the standard conditions that come with every consent.",
          "Have ready two recent passport-style photographs of yourself, a plan or photograph of your stall or vehicle, and your public liability insurance certificate.",
          "If you will sell food or drink, your food business must be registered with the local authority where it is based at least 28 days before you start trading.",
          "The fee is in the council's current schedule of fees. We cannot process the application until it is paid."
        ]
      },
      {
        "id": "0a120000-0000-4000-8000-000000000005",
        "type": "paragraph",
        "text": "How we use your information: the council uses the details on this form to decide your application and to manage your consent. We may share them with the police, the fire service and our environmental health team to check your application, and we publish the name, location and trading times of consent holders. We keep them for as long as your consent lasts and then for the period our retention schedule sets.",
        "runs": [
          {
            "text": "How we use your information:",
            "bold": true
          },
          {
            "text": " the council uses the details on this form to decide your application and to manage your consent. We may share them with the police, the fire service and our environmental health team to check your application, and we publish the name, location and trading times of consent holders. We keep them for as long as your consent lasts and then for the period our retention schedule sets."
          }
        ],
        "alignment": "left"
      },
