{
  "request": "health screening questionnaire for new members of my personal training studio, like a PAR-Q, with an emergency contact and consent",
  "title": "Pre-exercise readiness questionnaire",
  "description": "Give to every new member before their first session, to check whether they should get advice from a doctor before becoming more active, to record an emergency contact and to take their consent.",
  "maxPages": 2,
  "content": {
    "schemaVersion": 3,
    "branding": {
