    "blocks": [
      {
        "id": "d5030000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Pre-exercise readiness questionnaire",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "d5030000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Being more active is safe for most people. These questions help us find out whether you should speak to a doctor before you start training with us. Answer each one honestly, and ask your trainer if anything is unclear.",
        "alignment": "left"
      },
      {
        "id": "d5030000-0000-4000-8000-000000000003",
        "type": "paragraph",
        "text": "Your information. Your answers are about your health, so we treat them in confidence. Only your trainer and the studio manager see them, and only to plan safe training for you. We keep them for as long as you train with us and for a limited time afterwards, and we never share them unless you agree or we must in an emergency. You can ask to see your answers, correct them or have them deleted.",
        "alignment": "left",
        "runs": [
          {
            "text": "Your information.",
            "bold": true
          },
          {
            "text": " Your answers are about your health, so we treat them in confidence. Only your trainer and the studio manager see them, and only to plan safe training for you. We keep them for as long as you train with us and for a limited time afterwards, and we never share them unless you agree or we must in an emergency. You can ask to see your answers, correct them or have them deleted."
          }
        ]
      },
      {
