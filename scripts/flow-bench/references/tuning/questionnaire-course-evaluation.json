{
  "request": "end of course evaluation form for our first aid training courses",
  "title": "First aid course evaluation",
  "description": "Give to each learner at the end of a first aid course, to learn how much they gained, how relevant and well delivered it was, and what might stop them using what they learned.",
  "maxPages": 2,
  "content": {
    "schemaVersion": 3,
    "branding": {
      "organizationName": "",
      "logoAsset": null,
      "logoDataUrl": null,
      "logoAlignment": "left",
      "logoWidthPercent": 24,
      "primaryColor": "#252329",
      "accentColor": "#635273"
    },
    "blocks": [
      {
        "id": "d5020000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "First aid course evaluation",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "d5020000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Please tell us what you thought of the course. Your answers help us improve it for the next group. You do not need to give your name, and your trainer sees the answers only together with everyone else's.",
        "alignment": "left"
      },
      {
        "id": "d5020000-0000-4000-8000-000000000003",
        "type": "text_field",
        "fieldKey": "course_name",
        "label": "Course name",
        "required": true,
        "helpText": "For example Emergency first aid at work.",
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d5020000-0000-4000-8000-000000000005",
        "type": "date_field",
        "fieldKey": "course_date",
        "label": "Course date",
        "required": true,
        "helpText": null,
        "dateFormat": {
          "order": "dmy",
          "separator": " ",
          "month": "short"
        }
      },
      {
        "id": "d5020000-0000-4000-8000-000000000007",
        "type": "text_field",
        "fieldKey": "trainer_name",
        "label": "Trainer name",
        "required": false,
        "helpText": null,
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d5020000-0000-4000-8000-000000000033",
        "type": "choice_grid_field",
        "fieldKey": "first_aid_knowledge_and_skills",
        "label": "How would you rate your first aid knowledge and skills?",
        "required": true,
        "helpText": null,
        "rows": [
          "Before the course",
          "Now"
        ],
        "options": [
          "Not at all knowledgeable",
          "Slightly knowledgeable",
          "Moderately knowledgeable",
          "Very knowledgeable",
          "Extremely knowledgeable"
        ]
      },
      {
        "id": "d5020000-0000-4000-8000-000000000011",
        "type": "dropdown_field",
        "fieldKey": "how_relevant_is_this_course_to_your_work",
        "label": "How relevant is this course to your work?",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "options": [
          "Not at all",
          "Slightly",
          "Moderately",
          "Very",
          "Extremely"
        ],
        "display": "radios"
      },
      {
        "id": "d5020000-0000-4000-8000-000000000012",
        "type": "dropdown_field",
        "fieldKey": "how_confident_do_you_feel_about_acting_in_a_real_emergency",
        "label": "How confident do you feel about acting in a real emergency?",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "options": [
          "Not confident",
          "Fairly confident",
          "Very confident"
        ],
        "display": "radios",
        "across": true
      },
      {
        "id": "d5020000-0000-4000-8000-000000000013",
        "type": "dropdown_field",
        "fieldKey": "what_did_you_think_of_the_balance_between_talks_and_hands_on",
        "label": "What did you think of the balance between talks and hands-on practice?",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "options": [
          "Too much talking and not enough practice",
          "About the right balance",
          "Too much practice and not enough explanation"
        ],
        "display": "radios"
      },
      {
        "id": "d5020000-0000-4000-8000-000000000034",
        "type": "choice_grid_field",
        "fieldKey": "teaching_ratings",
        "label": "How would you rate each of these?",
        "required": true,
        "helpText": null,
        "rows": [
          "How clearly the trainer explained things",
          "How well the trainer answered your questions",
          "The practice equipment, such as the manikins and dressings",
          "The venue and facilities"
        ],
        "options": [
          "Excellent",
          "Good",
          "Fair",
          "Poor"
        ]
      },
      {
        "id": "d5020000-0000-4000-8000-000000000019",
        "type": "dropdown_field",
        "fieldKey": "will_you_use_what_you_learned_in_your_work",
        "label": "Will you use what you learned in your work?",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "options": [
          "Definitely yes",
          "Probably yes",
          "Possibly",
          "Probably not",
          "Definitely not",
          "Not applicable, I learned nothing new"
        ],
        "display": "radios"
      },
      {
        "id": "d5020000-0000-4000-8000-000000000035",
        "type": "dropdown_field",
        "fieldKey": "what_could_stop_you_using_what_you_learned",
        "label": "Could anything stop you using what you learned?",
        "required": false,
        "helpText": "Tick each that applies.",
        "placeholder": null,
        "options": [
          "I need more training on the subject",
          "I will not have the equipment or supplies I need",
          "I will not get the chance to use what I learned",
          "My manager or colleagues will not support me in using it",
          "The course was not relevant to my work",
          "Something else"
        ],
        "multiple": true
      },
      {
        "id": "d5020000-0000-4000-8000-000000000028",
        "type": "text_field",
        "fieldKey": "what_else_could_stop_you",
        "label": "What else could stop you?",
        "required": true,
        "helpText": null,
        "visibleWhen": {
          "sourceBlockId": "d5020000-0000-4000-8000-000000000035",
          "operator": "equals",
          "value": "Something else"
        },
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d5020000-0000-4000-8000-000000000029",
        "type": "text_field",
        "fieldKey": "which_part_of_the_course_helped_you_learn_the_most",
        "label": "Which part of the course helped you learn the most?",
        "required": false,
        "helpText": null,
        "placeholder": null,
        "multiline": true
      },
      {
        "id": "d5020000-0000-4000-8000-000000000031",
        "type": "text_field",
        "fieldKey": "how_could_we_improve_the_course",
        "label": "How could we improve the course?",
        "required": false,
        "helpText": null,
        "placeholder": null,
        "multiline": true
      },
      {
        "id": "d5020000-0000-4000-8000-000000000032",
        "type": "text_field",
        "fieldKey": "what_do_you_plan_to_put_into_practice_first",
        "label": "What do you plan to put into practice first?",
        "required": false,
        "helpText": null,
        "placeholder": null,
        "multiline": true
      }
    ],
