{
  "request": "accident and incident report form for our warehouse staff, covering injuries and near misses, witnesses, and what we did to stop it happening again",
  "title": "Accident and incident report",
  "description": "Use after any accident, injury or near miss in the warehouse, to record what happened, who saw it, and what is being done so it does not happen again.",
  "maxPages": 4,
  "content": {
    "schemaVersion": 3,
    "branding": {
      "organizationName": "",
      "logoAsset": null,
      "logoDataUrl": null,
      "logoAlignment": "left",
      "logoWidthPercent": 24,
      "primaryColor": "#252329",
      "accentColor": "#635273"
    },
    "blocks": [
      {
        "id": "d4030000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Accident and incident report",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "d4030000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Fill this in as soon as you can after any accident, injury or near miss, while the details are fresh. A near miss is worth reporting too: it shows where the next accident could happen.",
        "alignment": "left"
      },
      {
        "id": "d4030000-0000-4000-8000-000000000003",
        "type": "paragraph",
        "text": "Your information. This report holds personal details about the people involved. We use it to look into what happened, to make the workplace safer, and to deal with any insurance claim or report we must make to the authorities. Only the people who need it for those purposes see it, and we keep it for as long as the law and our insurer require.",
        "alignment": "left",
        "runs": [
          {
            "text": "Your information.",
            "bold": true
          },
          {
            "text": " This report holds personal details about the people involved. We use it to look into what happened, to make the workplace safer, and to deal with any insurance claim or report we must make to the authorities. Only the people who need it for those purposes see it, and we keep it for as long as the law and our insurer require."
          }
        ]
      },
      {
