      {
        "id": "0b120000-0000-4000-8000-000000000012",
        "type": "file_field",
        "fieldKey": "copy_of_your_vaccination_record_if_you_have_one",
        "label": "Copy of your vaccination record, if you have one",
        "required": false,
        "helpText": "For example, a page from your red book, a GP printout or a record from a previous employer."
      },
      {
        "id": "0b120000-0000-4000-8000-000000000014",
        "type": "paragraph",
        "text": "Two doses of MMR give lasting protection. If you are not sure you have had two, it is safe to have them again.",
        "alignment": "left"
      },
      {
        "id": "0b120000-0000-4000-8000-000000000060",
