          "separator": "/",
          "month": "number"
        }
      },
      {
        "id": "0b120000-0000-4000-8000-000000000009",
        "type": "text_field",
        "fieldKey": "gp_practice",
        "label": "GP practice",
        "required": false,
        "helpText": "Where your vaccinations are recorded.",
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "0b120000-0000-4000-8000-000000000011",
