        "fieldKey": "i_have_been_offered_this_season_s_vaccines_and_have_chosen_n",
        "label": "I have been offered this season's vaccines and have chosen not to have one or more of them.",
        "required": false,
        "helpText": null,
        "checkedByDefault": false
      },
      {
        "id": "0b120000-0000-4000-8000-000000000052",
        "type": "paragraph",
        "text": "I confirm that this record is correct as far as I know. I will tell the manager when I have another vaccine.",
        "alignment": "left"
