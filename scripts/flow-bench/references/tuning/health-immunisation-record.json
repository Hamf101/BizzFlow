{
  "request": "staff immunisation record for a care home",
  "title": "Staff immunisation record",
  "description": "Use when a care home member of staff starts, and each year after, to record the vaccines that protect them and the residents: MMR, chickenpox, hepatitis B where their role needs it, flu and COVID-19.",
  "maxPages": 2,
  "content": {
    "schemaVersion": 3,
    "branding": {
      "organizationName": "",
      "logoAsset": null,
      "logoDataUrl": null,
      "logoAlignment": "left",
      "logoWidthPercent": 24,
      "primaryColor": "#2b2d42",
      "accentColor": "#8d5a97"
    },
    "blocks": [
      {
        "id": "0b120000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Staff immunisation record",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "0b120000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Vaccines protect you, the residents you care for and your colleagues. This record shows which vaccines you have had, so that we can offer you any you are missing. Having a vaccine is your choice.",
        "alignment": "left"
      },
      {
        "id": "0b120000-0000-4000-8000-000000000003",
        "type": "paragraph",
        "text": "How we use your information: we use this record to offer you vaccines and to plan staffing during outbreaks. Only the manager and the person who keeps staff health records can see it. It is kept separately from your personnel file for as long as you work here, and we share it with an occupational health service only with your agreement.",
        "runs": [
          {
            "text": "How we use your information:",
            "bold": true
          },
          {
            "text": " we use this record to offer you vaccines and to plan staffing during outbreaks. Only the manager and the person who keeps staff health records can see it. It is kept separately from your personnel file for as long as you work here, and we share it with an occupational health service only with your agreement."
          }
        ],
        "alignment": "left"
      },
      {
        "id": "0b120000-0000-4000-8000-000000000005",
        "type": "text_field",
        "fieldKey": "full_name",
        "label": "Full name",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "0b120000-0000-4000-8000-000000000006",
