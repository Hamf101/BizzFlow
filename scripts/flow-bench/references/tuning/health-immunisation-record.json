          "order": "dmy",
          "separator": "/",
          "month": "number"
        }
      },
      {
        "id": "0b120000-0000-4000-8000-000000000043",
        "type": "paragraph",
        "text": "Care home staff are offered a flu vaccine each autumn, and a COVID-19 vaccine when the national programme includes them. Record the most recent dose of each.",
        "alignment": "left"
      },
      {
        "id": "0b120000-0000-4000-8000-000000000044",
