        "required": false,
        "helpText": null,
        "columns": [
          {
            "label": "Date given",
            "format": "date"
          },
          {
            "label": "Batch number"
          }
        ],
        "rows": 2
      },
      {
        "id": "0b120000-0000-4000-8000-000000000022",
        "type": "dropdown_field",
        "fieldKey": "have_you_had_chickenpox_or_shingles",
        "label": "Have you had chickenpox or shingles?",
        "required": true,
        "helpText": "If you are not sure, a blood test can show whether you are protected.",
        "placeholder": null,
        "options": [
          "Yes",
          "No",
          "Not sure"
        ],
        "display": "radios",
        "across": true
      },
      {
        "id": "0b120000-0000-4000-8000-000000000061",
