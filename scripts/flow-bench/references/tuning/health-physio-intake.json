    "blocks": [
      {
        "id": "0b160000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Physiotherapy intake questionnaire",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "0b160000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "Please fill this in before your first appointment. It gives your physiotherapist a picture of your problem and your general health, so that you can spend your appointment on assessment and treatment.",
        "alignment": "left"
      },
      {
        "id": "0b160000-0000-4000-8000-000000000003",
        "type": "paragraph",
        "text": "How we use your information: your physiotherapist uses your answers to assess and treat you. They are kept in your confidential clinical notes for as long as professional rules on record keeping require. We share them with your GP or the person who referred you only with your agreement below, or if you are at risk of serious harm.",
        "runs": [
          {
            "text": "How we use your information:",
            "bold": true
          },
          {
            "text": " your physiotherapist uses your answers to assess and treat you. They are kept in your confidential clinical notes for as long as professional rules on record keeping require. We share them with your GP or the person who referred you only with your agreement below, or if you are at risk of serious harm."
          }
        ],
        "alignment": "left"
      },
      {
