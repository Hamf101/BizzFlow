      {
        "id": "0b160000-0000-4000-8000-000000000055",
        "type": "choice_grid_field",
        "fieldKey": "warning_signs",
        "label": "Bladder, bowels, weight and cancer",
        "required": true,
        "helpText": null,
        "rows": [
          "Since this started, have you had any change in controlling your bladder or bowels?",
          "Do you have numbness around your bottom or genitals?",
          "Have you lost weight without trying?",
          "Have you ever been treated for cancer?"
        ],
        "options": [
          "Yes",
          "No"
        ]
      },
      {
        "id": "0b160000-0000-4000-8000-000000000035",
        "type": "paragraph",
        "text": "Important: if you have new problems controlling your bladder or bowels, or numbness around your bottom or genitals, go to A&E or call 999 now. Do not wait for your appointment.",
        "runs": [
          {
            "text": "Important:",
            "bold": true
          },
          {
            "text": " if you have new problems controlling your bladder or bowels, or numbness around your bottom or genitals, go to A&E or call 999 now. Do not wait for your appointment."
