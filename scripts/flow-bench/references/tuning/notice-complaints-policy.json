{
  "request": "complaints policy and procedure for our lettings agency, to give to landlords and tenants, with a form they can use to complain",
  "title": "Complaints policy and procedure",
  "description": "Give to landlords and tenants, and publish on the agency's website, to explain how to complain, what happens at each stage and when, how to take a complaint to the redress scheme, with a form for making a complaint.",
  "maxPages": 5,
  "content": {
    "schemaVersion": 3,
    "branding": {
      "organizationName": "",
      "logoAsset": null,
      "logoDataUrl": null,
      "logoAlignment": "left",
