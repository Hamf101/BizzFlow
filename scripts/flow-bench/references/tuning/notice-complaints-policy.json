      "primaryColor": "#252329",
      "accentColor": "#635273"
    },
    "blocks": [
      {
        "id": "d6040000-0000-4000-8000-000000000001",
        "type": "heading",
        "text": "Complaints policy and procedure",
        "level": 1,
        "alignment": "left"
      },
      {
        "id": "d6040000-0000-4000-8000-000000000002",
        "type": "paragraph",
        "text": "We want every landlord and tenant we work with to be happy with our service. When something goes wrong, we want to hear about it, so that we can put it right and learn from it. This policy explains how to complain, what we will do and when, and what you can do if you are still not satisfied.",
        "alignment": "left"
      },
      {
        "id": "d6040000-0000-4000-8000-000000000003",
        "type": "text_field",
        "fieldKey": "agency_name",
        "label": "Agency name",
        "required": true,
        "helpText": null,
        "placeholder": null,
        "multiline": false
      },
      {
        "id": "d6040000-0000-4000-8000-000000000005",
        "type": "text_field",
        "fieldKey": "name_of_person_who_handles_complaints",
        "label": "Name of person who handles complaints",
        "required": true,
