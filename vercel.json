{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "corepack pnpm install",
  "buildCommand": "corepack pnpm build",
  "devCommand": "corepack pnpm dev",
  "regions": ["cle1"],
  "crons": [
    {
      "path": "/api/cron/submission-file-cleanup",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/document-purge",
      "schedule": "45 3 * * *"
    }
  ]
}
